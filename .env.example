# Copy to .env (never committed): this machine's settings, and tokens every project may share.
# A project's own .agent-lab/.env wins over this file; a value set in the shell wins over both.

# GitHub token for Issues and comments (a project's own .agent-lab/.env may set its own).
GITHUB_TOKEN=
# GitHub token for the Project board (needs the project scope).
AGENT_LAB_PROJECT_TOKEN=

# How many ready, parallel-safe tasks run-plan runs together (1 to 8, default 3).
# AGENT_LAB_MAX_PARALLEL=3
# Seconds a test run may take before it counts as timed out (default 1200).
# AGENT_LAB_TEST_TIMEOUT=1200
# Fallback Python for a project's tests and its agents' `python`, used only when the project
# has no `python` in its .agent-lab.toml and no .venv of its own.
# AGENT_LAB_PYTHON=
# Folder for task worktrees (default: ~/agent-worktrees). Never inside a project.
# AGENT_LAB_WORKTREE_ROOT=
# Folder for the agent runner's files (default: the project's .agent-lab/agents).
# AGENT_LAB_AGENT_RUNS_DIR=
